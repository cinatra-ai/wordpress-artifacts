{
  "name": "@cinatra-ai/wordpress-artifacts",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "peerDependencies": {
    "@cinatra-ai/sdk-extensions": "*"
  },
  "peerDependenciesMeta": {
    "@cinatra-ai/sdk-extensions": {
      "optional": true
    }
  },
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "artifact",
    "displayName": "WordPress Artifacts",
    "vendor": {
      "key": "cinatra-ai",
      "name": "Cinatra"
    },
    "dependencies": [],
    "artifact": {
      "accepts": {
        "connectorRef": {
          "resolvedMimeTypes": [
            "text/html"
          ]
        }
      },
      "objectTypes": [
        {
          "type": "@cinatra-ai/wordpress:post",
          "claim": "dedicated",
          "dispositions": {
            "projection": "artifact-safe",
            "pinnable": false,
            "snapshotPolicy": "metadata",
            "sensitivity": "normal",
            "mutability": "external"
          },
          "schema": {
            "type": "object",
            "properties": {
              "artifactType": { "type": "string", "const": "connector-ref" },
              "originKind": { "type": "string", "const": "external_link" },
              "mime": { "type": "string", "minLength": 1 },
              "title": { "type": "string" },
              "excerpt": { "type": "string" },
              "connectorRef": {
                "type": "object",
                "properties": {
                  "url": { "type": "string", "minLength": 1 },
                  "connectorId": { "type": "string", "minLength": 1 },
                  "externalId": { "type": "string", "minLength": 1 },
                  "resolver": { "type": "string", "minLength": 1 },
                  "resolvedMimeType": { "type": "string", "minLength": 1 },
                  "state": { "type": "string", "enum": ["linked", "stale", "dangling"] },
                  "lastVerifiedAt": { "type": "string", "minLength": 1 },
                  "remoteVersion": { "type": "string", "minLength": 1 },
                  "title": { "type": "string" },
                  "excerpt": { "type": "string" }
                },
                "required": ["url", "connectorId", "externalId", "state"],
                "additionalProperties": false
              }
            },
            "required": ["artifactType", "originKind", "mime", "connectorRef"],
            "additionalProperties": true
          }
        }
      ]
    }
  }
}
